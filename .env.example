# =============================================================================
# Ocomme — Environment Variables Reference
#
# Copy this file to .env.local (for Docker Compose) or .env (for bare-metal)
# and fill in every value marked REQUIRED.
#
# NEVER commit a file containing real secrets to version control.
# =============================================================================

# =============================================================================
# Django — Core  (REQUIRED)
# =============================================================================

# Which settings module Django should load.
# Use "config.settings.development" locally, "config.settings.production" in prod.
DJANGO_SETTINGS_MODULE=config.settings.development

# A long, random string used for cryptographic signing.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Enable Django's debug mode.  Must be False in production.
DEBUG=True

# Comma-separated list of hostnames Django is allowed to serve.
# Example (production): ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,host.docker.internal

# =============================================================================
# Database — PostgreSQL  (REQUIRED)
# =============================================================================

# Database name
DB_NAME=ocomme_db

# Database user
DB_USER=ocomme_user

# Database password — use a strong, unique value in production!
DB_PASSWORD=change-me-strong-db-password

# Hostname of the PostgreSQL server.
# In Docker Compose this matches the service name defined in docker-compose.yml.
DB_HOST=postgres

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Seconds a database connection is kept alive between requests.
# 0 = close after every request (safe default).
# 60 = recommended for production with multiple Gunicorn workers.
DB_CONN_MAX_AGE=0

# PostgreSQL SSL mode: disable | allow | prefer | require | verify-ca | verify-full
# Use "require" or "verify-full" in production when the DB is on a separate host.
DB_SSLMODE=prefer

# =============================================================================
# Docker Compose — PostgreSQL service variables
# These are consumed by the postgres container, not by Django directly.
# =============================================================================
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# =============================================================================
# CORS  (REQUIRED in production)
# =============================================================================

# Comma-separated list of origins allowed to make cross-site requests.
# Example: CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Allow cookies / auth headers in cross-origin requests.
CORS_ALLOW_CREDENTIALS=True

# Set to True only for development/testing — never in production.
CORS_ALLOW_ALL_ORIGINS=False

# =============================================================================
# CSRF  (REQUIRED in production)
# =============================================================================

# Comma-separated list of origins trusted for CSRF verification.
# Must include every origin from which your frontend POSTs forms or API calls.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173

# =============================================================================
# Static & Media files  (OPTIONAL — defaults shown)
# =============================================================================

# Absolute filesystem path where collectstatic writes files.
STATIC_ROOT=/app/staticfiles

# Absolute filesystem path where uploaded media files are stored.
MEDIA_ROOT=/app/media

# =============================================================================
# Email  (OPTIONAL — console backend used when not set)
# =============================================================================

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Ocomme <noreply@example.com>
# SERVER_EMAIL=server@example.com

# =============================================================================
# Redis  (OPTIONAL — enables Redis cache and Celery broker)
# =============================================================================

# Full Redis connection URL.
# Example: REDIS_URL=redis://:yourpassword@redis:6379/0
# REDIS_URL=redis://redis:6379/0

# Maximum number of Redis connections in the pool (production tuning).
# REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Celery  (OPTIONAL — requires REDIS_URL or another broker)
# =============================================================================

# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# Logging  (OPTIONAL)
# =============================================================================

# Absolute path to the directory where Django writes rotating log files.
# The directory is created automatically if it does not exist.
# LOG_DIR=/app/logs

# =============================================================================
# Sentry error tracking  (OPTIONAL — production only)
# =============================================================================

# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=1.0.0

# =============================================================================
# Gunicorn / Container tuning  (OPTIONAL)
# =============================================================================

# Number of Gunicorn worker processes.
WEB_CONCURRENCY=3

# Database connection retry settings used by entrypoint.sh.
MAX_RETRIES=30
RETRY_INTERVAL=1
